{
  "name": "client/content-section",
  "title": "Content Section",
  "description": "Full-width section with optional background (image + overlay or solid color), any content, and configurable min height. No top or bottom curves.",
  "style": ["file:../library/css/style.css"],
  "category": "theme-blocks",
  "icon": "layout",
  "keywords": ["section", "background", "content", "container"],
  "acf": {
    "mode": "preview",
    "renderTemplate": "content_section.php"
  },
  "attributes": {
    "clientInsideContainer": {
      "type": "boolean",
      "default": true
    }
  },
  "providesContext": {
    "client/insideContainer": "clientInsideContainer"
  },
  "supports": {
    "jsx": true,
    "anchor": true,
    "align": ["full", "wide"]
  },
  "example": {
    "attributes": {
      "mode": "preview",
      "data": { "is_preview": true }
    }
  }
}