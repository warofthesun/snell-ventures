{
  "name": "client/contact-form",
  "title": "Contact Form",
  "description": "Contact form block with intro copy on a gradient panel. Form plugin is set in Site Settings.",
  "style": ["file:../library/css/style.css"],
  "category": "theme-blocks",
  "icon": "email",
